# Backend environment — copy to backend/.env on the server or locally.
# SIT: /opt/klip/backend/.env (or set the same OIDC_* vars in /opt/klip/.env — compose passes them through).
# See docs/SSO-OIDC-KLIP-SETUP.md and docs/DEPLOY-SIT-GITHUB.md

NODE_ENV=production
PORT=5001

# Database — SIT uses Aliyun RDS (set the same keys in /opt/klip/.env; Compose interpolates from there)
DB_HOST=pgm-d9jx9o06qae8gf3h.pgsql.ap-southeast-5.rds.aliyuncs.com
DB_PORT=5432
DB_NAME=klip_db
DB_USER=postgres
DB_PASSWORD=change-me

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Downstream Hub OIDC (must match Hub Admin → Applications → Logistic)
OIDC_DISCOVERY_URL=http://test-dwshub.kpndomain.com/api/sso/.well-known/openid-configuration
OIDC_CLIENT_ID=logistic
OIDC_REDIRECT_URI=http://test-klip.kpndomain.com/auth/oidc/callback
OIDC_SCOPES="openid email profile"
# Commercial Documents signs in through the same Hub as its own application (Hub Admin → Applications → Commercial Documents).
# Client id as registered in the Hub; redirect URI defaults to <COMMDOCS_URL>/auth/oidc/callback and must be registered there byte-for-byte.
# Without OIDC_COMMDOCS_CLIENT_ID the KLIP client id is used (a Hub that holds both domains as redirect URIs of ONE application).
OIDC_COMMDOCS_CLIENT_ID=
OIDC_COMMDOCS_REDIRECT_URI=

# Local username/password login (default true — SSO is an additional path, not a replacement)
LOCAL_LOGIN_ENABLED=true

# Session (generate: openssl rand -base64 48 — NOT from Hub)
SESSION_SECRET=
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

FRONTEND_URL=http://test-klip.kpndomain.com
TRUST_PROXY=1
# Optional: public IP if users open KLIP via IP instead of domain (CORS for cross-origin API)
CORS_EXTRA_ORIGINS=http://8.215.6.189
# Optional: public origin of the Commercial Documents app (same backend). Invite/reset links requested from that app open it;
# unset = every link opens KLIP. SIT: http://test-commercial-docs.kpndomain.com (production: http://commercial-docs.kpndomain.com)
# On a deployed host set it in /opt/klip/.env (the file compose substitutes from): docker-compose.backend.yml passes it explicitly, which beats backend/.env.
COMMDOCS_URL=
SSO_LEGACY_BRIDGE=false

UPLOAD_DIR=/app/uploads
# Production only: COMMERCIAL DOCS/{YYYY}/{MM} on \\172.30.1.94\APPs\dev\KLIP
# KLIP_ENV=sit
# KLIP_COMMERCIAL_DOCS_SHARE=0

# Email / SMTP (Contract ETA reminder and future notifications) — placeholders only, set real
# values directly in the server's .env (never commit real credentials).
EMAIL_FROM=noreply.sys@energi-up.com
SMTP_HOST=mail.energi-up.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply.sys@energi-up.com
SMTP_PASSWORD=change-me
SMTP_REJECT_UNAUTHORIZED=true

# Contract ETA reminder job — daily email to Logistics users (above Staff level) listing open
# contracts missing ETA within 14 days of their Cargo Readiness Date.
CONTRACT_ETA_REMINDER_ENABLED=true
CONTRACT_ETA_REMINDER_CRON=0 7 * * *
# Optional, comma/semicolon-separated extra recipients for testing/UAT (added on top of the
# DB-driven Logistics list). Leave empty for production — set on SIT/local for UAT.
CONTRACT_ETA_REMINDER_EXTRA_RECIPIENTS=
# Refuse backend start in production when DB_HOST points at co-located postgres (BE fork misconfig).
# KLIP_FAIL_ON_LOCAL_DB=true

# SAP folder auto-import (Synology Klip/SAP Data/Original → MASTER v2 at 07:00 Asia/Jakarta).
# Leave false until Original/Success/Failed exist on the upload mount.
SAP_AUTO_IMPORT_ENABLED=false
SAP_AUTO_IMPORT_CRON=0 7 * * *
# Container path. Default is <UPLOAD_DIR>/SAP Data
# SAP_AUTO_IMPORT_ROOT=/app/uploads/SAP Data
# Optional extra ADMIN email recipients (comma/semicolon), same pattern as ETA reminder.
SAP_AUTO_IMPORT_EXTRA_RECIPIENTS=

# Integrations menu (ADMIN): DHM / JPS settings can be saved from the app and override the
# values below. Saved secrets are encrypted with this key, which never leaves the environment.
# Keep it HERE (backend/.env): docker-compose.backend.yml reads it from env_file only.
# 32 bytes, hex or base64. Generate it straight into the file, without displaying it:
#   openssl rand -hex 32 | sed 's/^/INTEGRATION_SECRETS_KEY=/' >> backend/.env
# Losing it only means re-entering the saved secrets; each falls back to .env until then.
# INTEGRATION_SECRETS_KEY=

# Discharge Port filter (Shipments, Shipping Performance, Oil Loss): read SAP's port text as a Master Port (a plant name that is an alias maps to PORT <site>).
# Off by default = the port is listed and matched as SAP wrote it. Turn on once Master Port and discharge_port_aliases are tidy. Restart needed.
# DISCHARGE_PORT_MASTER_MAPPING=true

# DHM master-data hub (vessel replica + inbound). Off by default.
# Keys stay on the backend only — never put them in the frontend or git.
# DHM_ENABLED=false
# DHM_BASE_URL=http://172.28.92.56:2001/api
# DHM_PUBLIC_KEY=dhm_pk_...
# DHM_PRIVATE_KEY=dhm_sk_...
# DHM_WEBHOOK_SECRET=
# DHM_SYNC_CRON=*/15 * * * *
