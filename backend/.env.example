# =============================================================================
# KLIP Backend - Environment Variables
# Salin file ini menjadi .env dan sesuaikan nilainya
# cp .env.example .env
# =============================================================================

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=klip_db
DB_USER=klip
DB_PASSWORD=klip123

# JWT Authentication
JWT_SECRET=ganti-dengan-random-string-minimal-32-karakter
JWT_EXPIRES_IN=24h

# Server
PORT=5001
NODE_ENV=development

# OpenAI (opsional - untuk fitur Agent AI)
# Dapatkan API key dari https://platform.openai.com
OPENAI_API_KEY=
