{
  "name": "klip-backend",
  "version": "1.0.0",
  "description": "KLIP Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "db:seed": "ts-node src/database/seed.ts",
    "db:seed:prod": "node dist/database/seed.js",
    "backfill:operation-ids": "ts-node src/scripts/backfillOperationIdsMissingSto.ts",
    "migrate:sea-trucking-to-shipments": "ts-node src/scripts/migrateSeaTruckingToShipments.ts",
    "cleanup:false-land-trucking": "ts-node src/scripts/removeFalseLandTruckingOperations.ts",
    "cleanup:duplicate-trucking-op-id": "ts-node src/scripts/cleanupDuplicateTruckingByOperationId.ts",
    "cleanup:duplicate-trucking-op-id:confirm": "ts-node src/scripts/cleanupDuplicateTruckingByOperationId.ts --confirm",
    "cleanup:duplicate-trucking-per-contract": "ts-node src/scripts/cleanupDuplicateTruckingPerContract.ts",
    "cleanup:duplicate-trucking-per-contract:confirm": "ts-node src/scripts/cleanupDuplicateTruckingPerContract.ts --confirm",
    "cleanup:false-sea-shipments": "ts-node src/scripts/removeFalseSeaShipments.ts",
    "cleanup:master-plants": "ts-node src/scripts/clearMasterPlants.ts",
    "cleanup:master-plants:confirm": "ts-node src/scripts/clearMasterPlants.ts --confirm",
    "cleanup:master-plant-group": "ts-node src/scripts/clearMasterPlantGroupPlant.ts",
    "cleanup:master-plant-group:confirm": "ts-node src/scripts/clearMasterPlantGroupPlant.ts --confirm",
    "dedupe:sto-po-shipment": "ts-node src/scripts/dedupeShipmentStoPo.ts",
    "dedupe:sto-po-shipment:prod": "node dist/scripts/dedupeShipmentStoPo.js",
    "rollback:auto-dedupe-shipments": "ts-node src/scripts/rollbackAutoDedupeShipments.ts",
    "rollback:auto-dedupe-shipments:prod": "node dist/scripts/rollbackAutoDedupeShipments.js",
    "reconcile:sap-shipment-duplicates": "ts-node src/scripts/reconcileExistingSapShipmentDuplicates.ts",
    "pipeline-summary:refresh": "ts-node src/scripts/refreshPipelineDailySummary.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "audit:security": "npm audit --audit-level=moderate"
  },
  "keywords": [
    "logistics",
    "API"
  ],
  "author": "KPN",
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@types/xlsx": "^0.0.35",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.0.227",
    "pg": "^8.11.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tesseract.js": "^7.0.0",
    "winston": "^3.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
