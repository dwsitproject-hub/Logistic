# Copy to .env.local for local development.
#
# Recommended: use same-origin proxy (only port 3001 must be reachable).
# Next.js rewrites /api → backend :5001 (see next.config.js).
NEXT_PUBLIC_API_URL=/api
#
# Optional: call backend directly (requires port 5001 reachable from browser).
# NEXT_PUBLIC_API_URL=http://localhost:5001/api
