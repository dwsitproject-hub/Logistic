# KLIP single-origin reverse proxy (Option A from docs/SSO-TARGET-APP-INTEGRATION.md)
# Required for HttpOnly session cookies — browser, /api, and /auth must share one hostname.
#
# Install: copy to /etc/nginx/sites-available/klip and symlink sites-enabled, then nginx -t && systemctl reload nginx
#
# UI security headers (CSP / X-Frame-Options) are also set by Next.js (frontend/next.config.js).
# Setting them here is defense-in-depth for static/edge responses and when proxying Next.
# API (/api, /auth) already receives Helmet headers from Express — do not strip them.

# --- HTTP: redirect to HTTPS (enable after TLS certs are installed) ---
server {
    listen 80;
    server_name test-klip.kpndomain.com;
    return 301 https://$host$request_uri;
}

# --- HTTPS (VA Medium: HTTP Only Site) ---
# Replace ssl_certificate paths with the real cert/key from IT Security / Let's Encrypt.
server {
    listen 443 ssl http2;
    server_name test-klip.kpndomain.com;

    ssl_certificate     /etc/ssl/certs/test-klip.kpndomain.com.crt;
    ssl_certificate_key /etc/ssl/private/test-klip.kpndomain.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # HSTS — only after HTTPS is confirmed working end-to-end
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;

    # UI anti-clickjacking + CSP (also set by Next.js headers())
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' http: https: ws: wss:" always;

    # API routes → backend (Express on port 5001)
    location /api/ {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # OIDC SSO routes → backend (outside /api prefix)
    location /auth/ {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend UI → Next.js (port 3001)
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Temporary HTTP-only fallback (SIT without TLS yet — remove once 443 is live):
# server {
#     listen 80;
#     server_name test-klip.kpndomain.com;
#     # ... same location blocks as above, without ssl_* / HSTS ...
# }

# Build frontend with NEXT_PUBLIC_API_URL=/api (relative, same hostname).
# Backend env (HTTPS):
#   FRONTEND_URL=https://test-klip.kpndomain.com
#   TRUST_PROXY=1
#   SESSION_COOKIE_SECURE=true
#   OIDC_REDIRECT_URI=https://test-klip.kpndomain.com/auth/oidc/callback
