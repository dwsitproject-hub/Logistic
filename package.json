{
  "name": "klip-logistics-platform",
  "version": "1.0.0",
  "description": "KPN Logistics Intelligence Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend && npm start",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "backfill:operation-ids": "cd backend && npm run backfill:operation-ids",
    "migrate:sea-trucking-to-shipments": "cd backend && npm run migrate:sea-trucking-to-shipments",
    "cleanup:false-land-trucking": "cd backend && npm run cleanup:false-land-trucking",
    "cleanup:false-sea-shipments": "cd backend && npm run cleanup:false-sea-shipments",
    "db:reset-test-data": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-test-data.ps1",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:shipping-performance": "playwright test e2e/shipping-performance.spec.ts",
    "test:e2e:shipping-performance:headed": "playwright test e2e/shipping-performance.spec.ts --headed",
    "playwright:install": "playwright install chromium"
  },
  "keywords": [
    "logistics",
    "SAP",
    "intelligence",
    "platform"
  ],
  "author": "KPN",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "concurrently": "^8.2.2"
  }
}

