# Copy to /opt/klip/.env (same folder as docker-compose.backend.yml).
# Docker Compose substitutes ${DB_NAME}, ${DB_USER}, ${DB_PASSWORD} for the *postgres* service
# when the stack starts. Keep these aligned with backend/.env.
#
#   cp .env.example .env
#   # edit .env, then either duplicate DB_* into backend/.env or:  cp .env backend/.env
#
# For scripts run on the host (psql, ts-node) use DB_HOST=127.0.0.1 and DB_PORT=POSTGRES_PORT below.

DB_NAME=klip_db
DB_USER=klip_user
DB_PASSWORD=change-me

# Published Postgres port on the host (klip-postgres maps 127.0.0.1:POSTGRES_PORT -> 5432)
POSTGRES_PORT=5433

BACKEND_PORT=5001

# PostgreSQL pool (backend) — raise if Section 1 summaryOnly times out under load
# DB_POOL_MAX=40
# DB_POOL_CONNECTION_TIMEOUT_MS=10000

JWT_SECRET=change-me-in-production

# Downstream Hub SSO — see docs/SSO-OIDC-KLIP-SETUP.md and docs/SSO-INTEGRATION-GUIDE.md (legacy)
# Legacy HS256 bridge (Hub retired — enable only if operator re-enables bridge):
# SSO_LEGACY_BRIDGE=true
# SSO_TOKEN_SECRET=
# OIDC (primary — public client + PKCE, no client_secret):
# OIDC_DISCOVERY_URL=http://test-dwshub.kpndomain.com/api/sso/.well-known/openid-configuration
# OIDC_CLIENT_ID=logistic
# OIDC_REDIRECT_URI=http://test-klip.kpndomain.com/auth/oidc/callback
# OIDC_SCOPES=openid email profile
# SESSION_SECRET=   # openssl rand -base64 48 — NOT from Hub
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=false
# FRONTEND_URL=http://localhost:3001
# TRUST_PROXY=1
# KLIP frontend's public URL (legacy bridge redirect):
# APP_PUBLIC_ORIGIN=http://localhost:3001

# Pre-Planned shipment grouping — see docs/PRE-PLANNED-GROUPING-SPEC.md
# PRE_PLANNED_GROUPING_ENABLED=true
# PRE_PLANNED_WINDOW_TOL_DAYS=3
# PRE_PLANNED_MIN_OS_MT=100
# PRE_PLANNED_EXCLUDED_PLANTS=Blank,Trading

# Section 1 Attention Needed + Aging Overdue (temporary off — lighter Shipments/Trucking load)
# Set true to re-enable backend SQL + UI; rebuild frontend after changing NEXT_PUBLIC_*.
ATTENTION_INSIGHTS_ENABLED=false
NEXT_PUBLIC_ATTENTION_INSIGHTS_ENABLED=false

# Anthropic Claude — powers KLIP Agent AI (chat) and the AI Shipment Planner.
# Required for both; the chat agent returns HTTP 500 with a clear message without it.
# ANTHROPIC_API_KEY=sk-ant-...
# Shipment Planner model (Add New Shipment modal). Default: claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6
# KLIP Agent AI chat model — kept separate so tuning the chat cannot change the planner.
# Default: claude-sonnet-5
# ANTHROPIC_AGENT_MODEL=claude-sonnet-5
# Chat agent reasoning depth: low | medium | high | xhigh | max. Default: medium
# Raise for harder analysis (slower, more tokens); lower for faster replies.
# ANTHROPIC_AGENT_EFFORT=medium

# Upload storage (backend container)
UPLOAD_DIR=/app/uploads
# Default stack uses Docker volume `backend_uploads` (no Synology required).
# When Synology network is ready on staging, mount share then deploy with:
#   docker compose -f docker-compose.backend.yml -f docker-compose.backend.synology.yml up -d --build backend
# KLIP_UPLOAD_MOUNT=/mnt/synology-apps/dev/klip
