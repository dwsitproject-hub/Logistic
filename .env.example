# Copy to /opt/klip/.env (same folder as docker-compose.backend.yml).
# Docker Compose substitutes ${DB_NAME}, ${DB_USER}, ${DB_PASSWORD} for the *postgres* service
# when the stack starts. Keep these aligned with backend/.env.
#
#   cp .env.example .env
#   # edit .env, then either duplicate DB_* into backend/.env or:  cp .env backend/.env
#
# For scripts run on the host (psql, ts-node) use DB_HOST=127.0.0.1 and DB_PORT=POSTGRES_PORT below.

DB_NAME=klip_db
DB_USER=klip_user
DB_PASSWORD=change-me

# Published Postgres port on the host (klip-postgres maps 127.0.0.1:POSTGRES_PORT -> 5432)
POSTGRES_PORT=5433

BACKEND_PORT=5001

JWT_SECRET=change-me-in-production

# Upload storage (backend container). Staging: bind-mount Synology APPs/dev — see docs/STAGING-SYNOLOGY-UPLOADS.md
UPLOAD_DIR=/app/uploads
# Host path for docker-compose.backend.yml (backend server only) — Synology APPs/dev/klip
KLIP_UPLOAD_MOUNT=/mnt/synology-apps/dev/klip
